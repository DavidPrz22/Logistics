// AGREGAR CAMPO A ORDENN
// AGREGAR CAMPO A ORDENN
enum TipoDeOrden {
  DESPACHO_RUTA 
  VENTA_MOSTRADOR
}

model ordenDespacho {
  id                     Int            @id @default(autoincrement())
  numeroOrden            String         @unique
  clienteId              Int            
  choferId               Int?           
  almacenTransitoId      Int            
  fechaSalida            DateTime?      @default(now()) 
  estado                 EstadoOrdenDespacho? @default(PREPARACION)

  tasaCambioId           Int?
  tasaCambioValor        Decimal?             // Snapshot numérico de la tasa usada en la orden
  tipoOrden              TipoDeOrden
  ///
  // CAMPOS FINANCIEROS
  totalOriginal          Decimal?             @default(0.00) // Valor bruto enviado a ruta (USD)
  totalOriginalVes       Decimal?             @default(0.00) // Valor bruto enviado a ruta (VES)
  totalRechazado         Decimal?             @default(0.00) // Suma de (cantidadRechazada * precioUnitario)
  montoFacturadoNeto     Decimal?             @default(0.00) // totalOriginal - totalRechazado (Mercancía entregada/aceptada USD)
  montoFacturadoNetoVes  Decimal?             @default(0.00) // Mercancía entregada/aceptada en VES
  totalAbonado           Decimal?             @default(0.00) // Suma de cobros recibidos
  saldoNetoCobrar        Decimal?             @default(0.00) // montoFacturadoNeto - totalAbonado
  
  tasaCambio             tasaCambio?          @relation(fields: [tasaCambioId], references: [id])
  cliente                cliente        @relation(fields: [clienteId], references: [id])
  chofer                 chofer?        @relation(fields: [choferId], references: [id])
  almacenTransito        almacen        @relation(fields: [almacenTransitoId], references: [id], onDelete: Restrict)
  detalles               detalleOrden[]
  documentoDeuda         documentoDeuda?
}

model detalleOrden {
  id                 Int            @id @default(autoincrement())
  ordenId            Int            
  loteId             Int            
  cantidadEnviada    Int            
  precioUnitario     Decimal        // Precio unitario en USD
  precioUnitarioVes  Decimal?       // Snapshot precio unitario en VES
  subtotalVes        Decimal?       // Subtotal en VES al momento de la orden
  
  orden              ordenDespacho  @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  lote               lote           @relation(fields: [loteId], references: [id], onDelete: Restrict)
  
  rechazos           detalleRechazoOrden[]
  movimientos        movimientoInventario[]
}

model detalleRechazoOrden {
  id                 Int            @id @default(autoincrement())
  detalleOrdenId     Int
  cantidadRechazada  Int
  motivoRechazoId    Int
  almacenReingresoId Int
  usuarioId          Int
  fechaRechazo       DateTime?      @default(now())
  observaciones      String?

  detalleOrden       detalleOrden   @relation(fields: [detalleOrdenId], references: [id], onDelete: Restrict)
  motivoRechazo      motivoRechazo  @relation(fields: [motivoRechazoId], references: [id], onDelete: Restrict)
  almacenReingreso   almacen        @relation("AlmacenReingreso", fields: [almacenReingresoId], references: [id], onDelete: Restrict)
  usuario            usuario        @relation(fields: [usuarioId], references: [id])
  
  movimientos        movimientoInventario[]
}

model motivoRechazo {
  id            Int            @id @default(autoincrement())
  codigo        String         @unique
  descripcion   String
  requiereMerma Boolean?       @default(false) 
  rechazos      detalleRechazoOrden[]
}
