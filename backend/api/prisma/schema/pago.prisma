model divisa {
  id                Int               @id @default(autoincrement())
  codigo            String            @unique
  nombre            String
  esMonedaBase      Boolean?          @default(false) 
  tasasOrigen       tasaCambio[]      @relation("DivisaOrigen")
  tasasDestino      tasaCambio[]      @relation("DivisaDestino")
  transaccionesPago transaccionPago[]
  cuentasDestino    cuentaDestino[]
}

enum FuenteTasaCambio {
  BCV
  BINANCE_P2P
  BYBIT_P2P
  PARALELO
  ZELLE
}

model registroTasas {
  id          Int          @id @default(autoincrement())
  nombre      String?
  createdAt   DateTime     @default(now())
  tasasCambio tasaCambio[]
}

model tasaCambio {
  id              Int       @id @default(autoincrement())
  divisaOrigenId  Int       
  divisaDestinoId Int       
  tasa            Decimal
  tasaMoficada    Decimal?
  registroTasasId Int
  fuente          FuenteTasaCambio @default(PARALELO)
  fechaVigencia   DateTime? @default(now()) 

  divisaOrigen  divisa @relation("DivisaOrigen", fields: [divisaOrigenId], references: [id])
  divisaDestino divisa @relation("DivisaDestino", fields: [divisaDestinoId], references: [id])
  registroTasas registroTasas @relation(fields: [registroTasasId], references: [id], onDelete: Cascade)
  tasasAplicadas transaccionPago[]
}

model metodoPago {
  id                 Int               @id @default(autoincrement())
  codigo             String            @unique
  descripcion        String
  requiereReferencia Boolean?          @default(true) 
  transaccionesPago  transaccionPago[]
}

enum EstadoDocumentoDeuda {
  PENDIENTE
  PAGADO_PARCIAL
  PAGADO_TOTAL
  ANULADO
}

enum TipoDocumentoDeuda {
  FACTURA
  NOTA_CREDITO
}

enum ListadoOrigen {
  RUTA_LIQUIDADA
  VENTA_MOSTRADOR
}

model documentoDeuda {
  id                   Int                    @id @default(autoincrement())
  sistemaOrigen        ListadoOrigen
  ordenId              Int                    @unique
  clienteId            Int
  montoTotalBase       Decimal               // En FACTURA: Monto positivo. En NOTA_CREDITO: Monto a descontar.
  saldoPendienteBase   Decimal               // Saldo vivo por cobrar
  estado               EstadoDocumentoDeuda?  @default(PENDIENTE)
  tipoDocumento        TipoDocumentoDeuda?    @default(FACTURA)
  fechaEmision         DateTime?              @default(now()) 
  transaccionesPago    transaccionPago[]

  orden               ordenDespacho           @relation(fields: [ordenId], references: [id])
  cliente             cliente                 @relation(fields: [clienteId], references: [id])
  @@unique([sistemaOrigen, ordenId])
}

enum EstadoTransaccionPago {
  APROBADO
  ANULADO
  RECHAZADO
}

enum TipoCuentaDestino {
  CAJA_FISICA
  BANCO
  BILLETERA_DIGITAL
}

model cuentaDestino {
  id                Int               @id @default(autoincrement())
  nombre            String
  divisaId          Int
  tipo              TipoCuentaDestino

  divisa            divisa            @relation(fields: [divisaId], references: [id])
  transaccionesPago transaccionPago[]
}

enum TipoOperacionPago {
  INGRESO
  EGRESO
}

enum TipoDePago {
  ANTICIPO
  COBRO_FACTURA
  SALDO_A_FAVOR
}

model transaccionPago {
  id                   Int            @id @default(autoincrement())
  documentoId          Int?
  ordenId              Int?
  tipoDePago           TipoDePago         
  metodoPagoId         Int            
  divisaPagoId         Int            
  montoOrigen          Decimal
  tasaAplicadaId           Int
  montoEquivalenteBase Decimal
  numeroReferencia     String?
  estado               EstadoTransaccionPago? @default(APROBADO)
  tipoOperacion        TipoOperacionPago? @default(INGRESO)
  fechaPago            DateTime?      @default(now()) 
  cuentaDestinoId      Int?
  usuarioId            Int            

  documento     documentoDeuda? @relation(fields: [documentoId], references: [id], onDelete: Restrict)
  metodoPago    metodoPago     @relation(fields: [metodoPagoId], references: [id])
  divisa        divisa         @relation(fields: [divisaPagoId], references: [id])
  tasaAplicada  tasaCambio     @relation(fields: [tasaAplicadaId], references: [id])
  cuentaDestino cuentaDestino? @relation(fields: [cuentaDestinoId], references: [id], onDelete: Restrict)
  usuario       usuario        @relation(fields: [usuarioId], references: [id])
}
